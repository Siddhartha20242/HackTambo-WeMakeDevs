{
    "manifest_version": 3,
    "name": "Nexus Eye",
    "version": "1.0",
    "description": "Sends LeetCode submission results to the Nexus Dashboard.",
    "permissions": ["scripting", "activeTab"],
    "host_permissions": [
      "https://leetcode.com/*",
      "http://localhost:8000/*"
    ],
    "content_scripts": [
      {
        "matches": ["https://leetcode.com/problems/*"],
        "js": ["content.js"]
      }
    ]
  }